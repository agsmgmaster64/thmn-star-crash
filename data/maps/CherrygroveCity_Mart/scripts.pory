mapscripts CherrygroveCity_Mart_MapScripts {}

script CherrygroveCity_Mart_EventScript_Clerk {
	lock
	faceplayer
	message(gText_HowMayIServeYou)
	waitmessage
	if (flag(FLAG_ADVENTURE_STARTED)) {
		goto(CherrygroveCity_Mart_EventScript_ExpandedItems)
	}
	pokemart(CherrygroveCity_Mart_Pokemart_Basic)
	msgbox(gText_PleaseComeAgain, MSGBOX_DEFAULT)
	release
	end
}

script CherrygroveCity_Mart_EventScript_ExpandedItems {
	pokemart
	msgbox(gText_PleaseComeAgain, MSGBOX_DEFAULT)
	release
	end
}

mart CherrygroveCity_Mart_Pokemart_Basic {
	ITEM_POTION
	ITEM_ANTIDOTE
	ITEM_PARALYZE_HEAL
	ITEM_AWAKENING
}
