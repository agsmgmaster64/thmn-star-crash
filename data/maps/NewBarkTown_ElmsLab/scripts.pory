	        "from Prof. Elm!")
}

text NewBarkTown_ElmsLab_Text_ElmFindMrMan {
    format("Find her.ogg")
}

text NewBarkTown_ElmsLab_Text_StarterChosenAlready {
    format("You made your choice")
}

text NewBarkTown_ElmsLab_Text_AideGivePotion {
    format("A potion")
}
