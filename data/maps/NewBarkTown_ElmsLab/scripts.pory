script NewBarkTown_ElmsLab_EventScript_AideAssist2Common {
    msgbox(NewBarkTown_ElmsLab_Text_AideGiveOrbs)
    giveitem(ITEM_TOHO_ORB, 5)
    setvar(VAR_NEW_BARK_TOWN_LAB_STATE, 6)
    closemessage
    return
}

movement NewBarkTown_ElmsLab_Movement_Approach_Elm1 {
    walk_up * 3
    walk_right * 1
    face_up
}

movement NewBarkTown_ElmsLab_Movement_Approach_Elm2 {
    walk_up * 3
}

movement NewBarkTown_ElmsLab_Movement_Approach_Elm3 {
    walk_up * 3
    walk_left * 1
    face_up
}

movement NewBarkTown_ElmsLab_Movement_Assist_Elm1 {
    walk_left * 2
    walk_up
}

movement NewBarkTown_ElmsLab_Movement_Assist_Elm2 {
    walk_left * 3
    walk_up
}

movement NewBarkTown_ElmsLab_Movement_Assist_Elm3 {
    walk_left * 4
    walk_up
}

movement NewBarkTown_ElmsLab_Movement_Aide_Approach1 {
    walk_left * 4
    walk_up
}

movement NewBarkTown_ElmsLab_Movement_Aide_Approach2 {
    walk_left * 3
    walk_up
}

movement NewBarkTown_ElmsLab_Movement_Aide_Approach3 {
    walk_left * 2
    walk_up
}

movement NewBarkTown_ElmsLab_Movement_Aide_GoBack1 {
    walk_down
    walk_right * 4
}

movement NewBarkTown_ElmsLab_Movement_Aide_GoBack2 {
    walk_down
    walk_right * 3
}

movement NewBarkTown_ElmsLab_Movement_Aide_GoBack3 {
    walk_down
    walk_right * 2
}

movement NewBarkTown_ElmsLab_Movement_StarterNoLeave {
    walk_up
}

movement NewBarkTown_ElmsLab_Movement_GoToOfficer {
    walk_up * 7
}

movement NewBarkTown_ElmsLab_Movement_PoliceExit {
    walk_left
    walk_down * 7
}

