}

text NewBarkTown_ElmsLab_Text_Starter2Choose {
    format("Starter 2?")
}

text NewBarkTown_ElmsLab_Text_Starter3Choose {
    format("Starter 3?")
}

text NewBarkTown_ElmsLab_Text_ElmChooseStarter {
